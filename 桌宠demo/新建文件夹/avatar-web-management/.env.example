# =============================================================================
# 虚拟形象管理平台 - 环境变量配置
# =============================================================================
# 使用说明：
# 1. 复制本文件为 .env（生产）或 .env.local（开发）
# 2. 替换所有 <placeholder> 为实际值
# 3. .env 文件不会被提交到 Git
# =============================================================================

# ---- 应用配置 ----
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_PORT=3001
# AIRI_STAGE_URL=http://127.0.0.1:3000/airi-stage-mock/
# CORS 白名单：允许跨域访问的 Origin 列表（逗号分隔）
# 留空则仅允许 localhost / 127.0.0.1 / *.local
# CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# ---- PostgreSQL 数据库 ----
# 本机运行 Next.js 时使用 localhost；Compose 中的应用会自动改用 postgres 服务名。
# POSTGRES_PASSWORD 与 DATABASE_URL 中的密码必须一致，建议仅使用 URL-safe 字符。
POSTGRES_DB=avatar_management
POSTGRES_USER=avatar
POSTGRES_PASSWORD=<replace-with-strong-url-safe-password>
DATABASE_URL=postgresql://avatar:<replace-with-strong-url-safe-password>@localhost:5432/avatar_management
# 生产环境连接池大小可通过 PG_POOL_MAX 调整（默认 20）
# PG_POOL_MAX=20
# 连接池最小空闲连接数（默认 1）
# PG_POOL_MIN=1
# 空闲连接超时（毫秒，默认 30000）
# PG_POOL_IDLE_TIMEOUT=30000
# 连接获取超时（毫秒，默认 5000）
# PG_CONNECTION_TIMEOUT=5000
# 数据库备份目标目录（默认 backups/）
# BACKUP_DIR=backups
# 备份保留数量（默认 0 = 不清理）
# BACKUP_RETAIN=7

# ---- JWT 认证 ----
# HS256 回退密钥（仅开发环境，RSA 配置后自动忽略）
JWT_SECRET=<your-jwt-secret-here>
# RSA 密钥目录（默认 keys/）
# JWT_KEYS_DIR=keys
# RSA 私钥路径（默认 keys/private.pem）
# JWT_PRIVATE_KEY_PATH=keys/private.pem
# RSA 公钥路径（默认 keys/public.pem）
# JWT_PUBLIC_KEY_PATH=keys/public.pem
# 密钥 ID
# JWT_KEY_ID=kid-001
# 也可通过环境变量直接注入密钥内容:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
# 访问令牌过期时间（默认 15m）
# JWT_ACCESS_EXPIRY=15m
# 刷新令牌过期天数（默认 7）
# JWT_REFRESH_EXPIRY_DAYS=7

# ---- 反向代理信任 ----
# 默认不信任客户端提供的 x-forwarded-for / x-real-ip。
# 只有当前置反向代理会覆盖（而非追加）这些请求头，并注入下方共享认证头时才可启用。
# TRUST_PROXY_HEADERS=true
# TRUST_PROXY_SECRET=<random-secret-shared-with-your-proxy>

# ---- 按需缓存刷新 ----
# 不配置时 /api/revalidate 返回 503，不使用默认密钥。
# REVALIDATE_SECRET=<replace-with-random-secret>

# ---- 企业 SSO (OIDC) ----
# Compose 内置 Keycloak 的管理账号与数据库密码（启用 Compose 时必填）
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<replace-with-strong-keycloak-admin-password>
KEYCLOAK_DB_PASSWORD=<replace-with-strong-keycloak-database-password>
# IdP 发行者 URL
# SSO_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# 或使用 Azure AD 租户 ID
# AZURE_AD_TENANT=<tenant-id>
# 或使用 Keycloak
# KEYCLOAK_URL=http://localhost:8080/realms/avatar
# OAuth 客户端 ID
# SSO_CLIENT_ID=avatar-web-app
# OAuth 客户端密钥
# SSO_CLIENT_SECRET=avatar-web-app-secret
# 回调地址
# SSO_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback

# ---- 对象存储 (MinIO / S3) ----
# Compose 内置 MinIO 的根账号（启用 Compose 时必填）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<replace-with-strong-minio-root-password>
# 驱动：留空使用本地文件系统，设为 minio 使用 MinIO
# STORAGE_DRIVER=
# MinIO 服务地址
# STORAGE_ENDPOINT=localhost
# STORAGE_PORT=9000
# STORAGE_USE_SSL=false
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin123
# STORAGE_BUCKET=avatar-assets
# 公网访问 URL（文件直链）
# STORAGE_PUBLIC_URL=http://localhost:9000
# 本地文件系统存储目录（默认 public/uploads）
# STORAGE_LOCAL_DIR=public/uploads

# ---- Redis (缓存 / 速率限制) ----
# 不设置则优雅降级
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_KEY_PREFIX=avatar:

# ---- WebSocket 端口 (编辑器实时同步) ----
# WS_PORT=3001

# ---- OpenTelemetry 分布式追踪 ----
# 不设置 OTEL_EXPORTER_OTLP_ENDPOINT 则仅输出到控制台（开发模式）
# OTEL_SERVICE_NAME=avatar-web
# OTLP Collector 地址（Jaeger / Grafana Tempo / Datadog Agent 等）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# 采样策略: always_on | parentbased_always_on | parentbased_traceidratio
# OTEL_TRACES_SAMPLER=parentbased_always_on
# 采样率（仅 parentbased_traceidratio 模式生效，0.0-1.0）
# OTEL_TRACES_SAMPLER_ARG=1.0
# 额外资源属性
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# ---- Sentry 错误监控 (可选) ----
# SENTRY_DSN=
